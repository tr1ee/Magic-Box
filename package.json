{
  "name": "local-torrent-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "clean": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/clean-workspace.ps1",
    "cleanup:magicbox": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup-magicbox.ps1",
    "test": "node scripts/run-test-suites.mjs",
    "test:voice-evaluators": "node scripts/verify-voice-evaluators.mjs",
    "test:voice-golden": "node scripts/run-voice-clone-golden-soak.mjs --mode golden --pipeline both",
    "test:voice-soak": "node scripts/run-voice-clone-golden-soak.mjs --mode soak --pipeline v2 --count 100 --persistent-workers --gpt-candidate-count 1 --seed-candidate-count 3",
    "migrate:voice-sqlite": "node scripts/migrate-voice-clone-json-to-sqlite.mjs",
    "test:voice-unit": "node --test --test-concurrency=1 test/live-voice.test.mjs test/speech-planner.test.mjs test/audio-worklet-resampler.test.mjs test/audio-ring-buffer.test.mjs",
    "verify:voice-continuity": "python scripts/analyze-pcm-continuity.py artifacts/voice-poc-run2/incremental-single-session.wav",
    "test:voice-integration": "node --test --test-concurrency=1 test/live-voice.test.mjs",
    "benchmark:live-voice:hot": "node scripts/benchmark-live-voice-mode.mjs hot",
    "benchmark:live-voice:cold": "node scripts/benchmark-live-voice-mode.mjs cold",
    "benchmark:live-voice:device": "node scripts/benchmark-live-voice-mode.mjs device",
    "verify:voice-barge-in": "node scripts/verify-voice-barge-in.mjs",
    "verify:voice-long-session": "node scripts/verify-voice-long-session.mjs",
    "test:voice-song-integrity": "node scripts/test-voice-song-integrity.mjs",
  "vtv:baseline": "node scripts/create-vtv-baseline-manifest.mjs",
  "vtv:corpus": "node scripts/build-vtv-corpus-manifest.mjs",
      "vtv:dataset": "node scripts/build-vtv-finetune-dataset.mjs",
      "vtv:profile-samples": "node scripts/export-vtv-profile-samples.mjs",
  "vtv:finetune": "node scripts/run-vtv-finetune.mjs",
  "vtv:gpu-regression": "node scripts/run-vtv-gpu-regression.mjs",
  "vtv:roformer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-vtv-roformer.ps1",
  "vtv:separator-bakeoff": "node scripts/run-vtv-separator-bakeoff.mjs",
  "vtv:nightly": "node scripts/run-vtv-nightly.mjs",
    "vtv:full-song": "node scripts/run-vtv-full-song-regression.mjs",
    "vtv:full-song-nightly": "node scripts/run-vtv-full-song-nightly.mjs",
    "vtv:abx": "node scripts/build-vtv-abx-assignments.mjs",
    "vtv:abx-cases": "node scripts/build-vtv-abx-case-spec.mjs",
    "vtv:song-bakeoff": "node scripts/build-vtv-song-finetune-bakeoff.mjs",
  "vtv:promotion-report": "node scripts/build-vtv-promotion-report.mjs",
  "vtv:promotion-from-gpu": "node scripts/build-vtv-promotion-from-gpu-reports.mjs",
    "test:voice-preparation": "node scripts/test-voice-preparation-waveform.mjs",
    "test:assistant": "node --test --test-concurrency=1 test/assistant.test.mjs",
    "test:assistant-ui": "vitest run test/assistant-ui.test.jsx",
    "test:launcher-logs": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-launcher-logs.ps1",
    "test:ui": "vitest run && node scripts/verify-ui-test-discovery.mjs",
    "verify:lazy-tool-pages": "node scripts/verify-lazy-tool-pages.mjs --manifest dist/.vite/manifest.json --entry-budget 300000",
    "verify:hardening-package": "node scripts/verify-hardening-package.mjs --package release/chromium/MagicBox --launch-smoke --voice-ingress --verify-lazy-pages",
    "smoke:assistant-models": "node scripts/assistant-smoke-launcher.mjs models",
    "smoke:assistant-index": "node scripts/assistant-smoke-launcher.mjs index",
    "smoke:assistant-chat": "node scripts/assistant-smoke-launcher.mjs chat",
    "smoke:assistant-automation": "node scripts/assistant-smoke-launcher.mjs automation",
    "smoke:assistant-integrations": "node scripts/assistant-smoke-launcher.mjs integrations",
    "verify:assistant-ui": "npm.cmd run test:assistant-ui && node scripts/verify-assistant-package.mjs",
    "verify:assistant-release": "node scripts/assistant-release-verify.mjs",
    "benchmark:live-voice": "node scripts/benchmark-live-voice.mjs",
    "trace:live-voice-field": "node scripts/trace-live-voice-field.mjs",
    "summarize:live-voice-trace": "node scripts/summarize-live-voice-trace.mjs",
    "render:live-voice-timeline": "node scripts/render-live-voice-timeline.mjs",
    "benchmark:resource-matrix": "node scripts/benchmark-private-agent-resource-matrix.mjs",
    "verify:voice-continuity-gate": "node scripts/verify-live-voice-continuity.mjs",
    "evaluate:voice-profile": "node scripts/evaluate-voice-profile.mjs",
    "evaluate:tts-provider": "node scripts/evaluate-tts-provider-decision.mjs",
    "verify:private-agent-release-gates": "node scripts/verify-private-agent-release-gates.mjs",
    "verify:voice-cold-start": "node scripts/test-voice-preference-cold-start.mjs",
    "verify:voice-preference-migration": "node scripts/verify-voice-preference-migration.mjs",
    "smoke:live-voice-roundtrip": "node scripts/smoke-live-voice-roundtrip.mjs",
    "verify:live-voice-release": "node scripts/verify-live-voice-release.mjs",
    "verify:live-voice-input": "node scripts/verify-live-voice-input.mjs",
    "verify:voice-listening-review": "node scripts/validate-voice-listening-review.mjs",
    "build": "vite build",
    "desktop:mac:kit": "node scripts/prepare-macos-kit.mjs",
    "desktop:mac": "bash Build-Mac.command",
    "desktop:basic": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows-build.ps1 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-webview2.ps1 -Basic",
    "desktop:installer:basic": "npm run desktop:basic && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Basic",
    "desktop": "npm run desktop:webview2 && start \"\" \"release\\chromium\\MagicBox\\MagicBox.exe\"",
    "desktop:webview2": "npm run build && npm run verify:live-voice-release && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-webview2.ps1",
    "desktop:installer": "npm run desktop:webview2 && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "desktop:serve": "start \"\" \"release\\chromium\\MagicBox\\MagicBox.exe\"",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.2",
    "webtorrent": "^3.0.16",
    "ws": "^8.21.1"
  },
  "overrides": {
    "bittorrent-tracker@11.2.3": {
      "ip": "npm:@eggjs/ip@2.1.0"
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
